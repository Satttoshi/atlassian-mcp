# Copy to .env and fill in. .env is gitignored; never commit real values.

# The email address of your Atlassian account.
ATLASSIAN_EMAIL=you@company.com

# Your Atlassian site (Jira and Confluence share it).
# Several sites: separate them with commas. The first one is the default, and
# each is addressed by its subdomain (here "your-company" and "other-org").
#ATLASSIAN_SITE_URL=https://your-company.atlassian.net,https://other-org.atlassian.net
ATLASSIAN_SITE_URL=https://your-company.atlassian.net

# --- API tokens: pick ONE of the two options -------------------------------
# Create tokens at https://id.atlassian.com/manage-profile/security/api-tokens
# Tokens belong to your account, so they work for every site listed above.

# Option 1: one unscoped token for both Jira and Confluence (simplest).
ATLASSIAN_API_TOKEN=your-api-token

# Option 2: scoped read-only tokens, one per app (Atlassian binds a scoped
# token to a single app). Set one or both and leave ATLASSIAN_API_TOKEN empty;
# a product without a token is simply unavailable.
# Jira scopes: read:jira-work, read:jira-user.
# Confluence scopes: see "Confluence token scopes" in the README.
#JIRA_API_TOKEN=your-jira-token
#CONFLUENCE_API_TOKEN=your-confluence-token

# A product-specific token always wins over ATLASSIAN_API_TOKEN for that product.

# Almost never needed: the server detects the correct base URL automatically
# (scoped tokens require https://api.atlassian.com/ex/jira/{cloudId}).
# Set this only if startup logs say cloud-ID detection failed. Single site only.
#ATLASSIAN_CLOUD_ID=

# Optional: Jira writes (update, create, comment, transition, link). Off unless
# JIRA_WRITE_PROJECTS is set. They use the Jira token (JIRA_API_TOKEN, else
# ATLASSIAN_API_TOKEN), which then needs write:jira-work too; or set a separate
# JIRA_WRITE_API_TOKEN (read:jira-work, write:jira-work, read:jira-user) to keep
# the read token read-only. With several sites, the projects apply to all of them.
# Comma-separated project keys the write tools may touch, e.g. AC
#JIRA_WRITE_PROJECTS=
#JIRA_WRITE_API_TOKEN=
