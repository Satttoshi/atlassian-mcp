# Copy to .env and fill in. .env is gitignored — never commit real values.

# The email address of your Atlassian account.
ATLASSIAN_EMAIL=you@company.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Create it with ONLY the read scopes: read:jira-work, read:jira-user.
ATLASSIAN_API_TOKEN=your_token

# Your Atlassian site (Jira and Confluence share it), e.g. https://your-company.atlassian.net
ATLASSIAN_SITE_URL=https://your-company.atlassian.net

# Optional: a separate token for Confluence. Scoped tokens are bound to one
# app, so a token created for Jira cannot read Confluence. Leave unset to use
# ATLASSIAN_API_TOKEN for both (fine for unscoped tokens).
# Read scopes to select: see "Confluence token scopes" in the README.
#CONFLUENCE_API_TOKEN=

# Almost never needed: the server detects the correct base URL automatically
# (scoped tokens require https://api.atlassian.com/ex/jira/{cloudId}).
# Set this only if startup logs say cloud-ID detection failed.
#ATLASSIAN_CLOUD_ID=

# Optional: Jira writes (update, create, comment, transition, link). Off unless
# JIRA_WRITE_PROJECTS is set. They use ATLASSIAN_API_TOKEN, which then needs
# write:jira-work too; or set a separate JIRA_WRITE_API_TOKEN (read:jira-work,
# write:jira-work, read:jira-user) to keep the read token read-only.
# Comma-separated project keys the write tools may touch, e.g. AC
#JIRA_WRITE_PROJECTS=
#JIRA_WRITE_API_TOKEN=
